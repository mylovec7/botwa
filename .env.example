# Phone number for the WhatsApp account CHELYN should log in as.
# Country code + number, digits only, no +, spaces, or dashes.
# Example: 15551234567
WHATSAPP_PHONE_NUMBER=

# Optional: folder where the WhatsApp auth/session state is persisted.
# Must point at a persistent volume on your host so it survives restarts.
# Defaults to "session" if not set.
AUTH_DIR=session
